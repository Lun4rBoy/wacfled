@page
@model WebAssistanConector.Pages.HomeModel
@{
    ViewData["Title"] = "wacfLed";
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <style>
        .button-container {
            margin-top: 20px;
        }

        .btn {
            font-size: 18px;
            margin: 5px;
        }

        #eventViewer {
            margin-top: 20px;
            background-color: #f8f9fa;
            padding: 10px;
            border: 1px solid #ced4da;
            height: 150px;
            overflow-y: auto;
        }
    </style>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
</head>

<body>
    <div class="container">

        <div class="row justify-content-center">
            <h1 class="mt-5 text-center text-white">Controlador de LED</h1>
            <!--<div class="text-center mb-4">
                <a href="/Model3D" class="btn btn-primary" style="background-color:#947EB0; border-color:#947EB0">
                    <i class="fas fa-cube"></i> Ver Modelo 3D
                </a>
            </div>-->
        </div>
        <div class="container text-center">
            <div class="row">
                <div class="col-12 col-md-6 mt-4">
                    <div class="container">

                        <!--<form id="botonTest" class="mb-3">
                             <button type="submit" class="btn btn-primary w-100" style="background-color:#947EB0; border-color:#947EB0">Boton test</button>
                         </form>-->

                        <form id="ipForm" class="mb-3">
                            <div class="row align-items-center">
                                <div class="col-12 col-md-3">
                                    <label for="ipDevice" class="h5 text-white mb-0">Ip dispositivo:</label>
                                </div>
                                <div class="col-12 col-md-9">
                                    <div class="d-flex align-items-stretch">
                                        <div style="width: 80%;">
                                            <select class="form-select" id="ipDevice" 
                                                    style="color: white; border: 1px solid #333; border-right: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; height: 38px; display: flex; align-items: center;">
                                                <option value="manual">Ingreso manual</option>
                                                <option selected>Searching...</option>
                                            </select>
                                            <input type="text" class="form-control d-none" id="manualIp" 
                                                   placeholder="192.168.x.x" 
                                                   style="color: white; border: 1px solid #333; border-right: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; height: 38px; display: flex; align-items: center;">
                                        </div>
                                        <div style="width: 20%; display: flex;">
                                            <button class="btn w-100 d-flex align-items-center justify-content-center" type="button" id="refreshIps" 
                                                    style="background-color:#947EB0; border-color:#333; border-left: 0; border-top-left-radius: 0; border-bottom-left-radius: 0; height: 38px; margin: 0;">
                                                <i class="fas fa-sync-alt text-white"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>

                        <form id="infoForm" class="mb-3">
                            <button type="submit" class="btn btn-primary w-100"
                                style="background-color:#947EB0; border-color:#947EB0">Ver informacion</button>
                        </form>
                        <form id="colorForm" class="mb-3">
                            <div class="row">
                                <div class="col">
                                    <input type="color" id="colorInput" class="w-100 h-100" value="#FFEAEE"
                                        style="border-radius:9px;border-color:none" />
                                </div>
                                <div class="col">
                                    <button type="submit" class="btn btn-primary w-100 mt-2"
                                        style="background-color:#947EB0; border-color:#947EB0">Cambiar Color</button>
                                </div>
                            </div>

                        </form>

                        <form id="speedForm" class="mb-3">
                            <input type="range" id="speedInput" min="1" max="255" class="form-control-range w-75 h-100"
                                style="accent-color:#FFD2D7" />
                            <button type="submit" class="btn btn-primary w-100 mt-2"
                                style="background-color:#947EB0; border-color:#947EB0">Cambiar Velocidad</button>
                        </form>

                        <form id="brightnessForm" class="mb-3">
                            <input type="range" id="brightnessInput" min="1" max="255"
                                class="form-control-range w-75 h-100" style="accent-color:#FFD2D7" />

                            <button type="submit" class="btn btn-primary w-100 mt-2"
                                style="background-color:#947EB0; border-color:#947EB0">Cambiar Brillo</button>

                        </form>

                        <form id="animationForm" class="mb-3">
                            <select id="animationSelect" class="form-select w-100 mt-2" style="margin:5px">
                                <option value="99" selected>Opciones</option>
                                <option value="0">Mix</option>
                                <option value="1">Meteor</option>
                                <option value="2">Breathing</option>
                                <option value="3">Wave</option>
                                <option value="4">Catch-up</option>
                                <option value="5">Static</option>
                                <option value="6">Stack</option>
                                <option value="7">Flash</option>
                                <option value="8">Flow</option>
                            </select>
                            <button type="submit" class="btn btn-primary w-100 mt-2"
                                style="background-color:#8062D6; border-color:#8062D6">Cambiar animacion</button>
                        </form>

                        <form id="toggleForm">
                            <button type="submit" class="btn btn-danger w-100"
                                style="background-color:#9288F8; border-color:#8062D6">Encender/Apagar</button>
                        </form>
                    </div>
                </div>

                <div class="col-12 col-md-6 mt-4 mb-4">
                    <div id="model3d-container" style="
                        height: 500px;
                        width: 100%;
                        border-radius: 7% 7% 7% 7%;
                        display: flex;
                        justify-content: center;
                        align-items: center;
                        overflow: visible;
                        position: relative;
                        z-index: 1;
                    "></div>
                </div>
            </div>
        </div>
    </div>
    

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <script type="importmap">
    {
        "imports": {
            "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
            "three/examples/jsm/controls/OrbitControls": "https://unpkg.com/three@0.160.0/examples/jsm/controls/OrbitControls.js"
        }
    }
    </script>
    <script type="module" src="~/js/model3d.js"></script>
    <script src="~/js/controladorLed.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>
